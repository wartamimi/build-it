<?xml version="1.0" encoding="utf-8"?>
<!-- Projects can be large; users back them up explicitly with ZIP export. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="workspace/" />
        <include domain="database" />
    </device-transfer>
</data-extraction-rules>
